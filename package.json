{
  "name": "montaj",
  "productName": "Montaj",
  "version": "0.1.0",
  "description": "محرر فيديو عربي لسطح المكتب",
  "author": "Montaj",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:renderer": "vite build",
    "start": "npm run build:renderer && electron .",
    "dist": "npm run build:renderer && electron-builder --win --x64",
    "release": "npm run build:renderer && electron-builder --win --x64 --publish always"
  },
  "build": {
    "appId": "com.montaj.editor",
    "productName": "Montaj",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Montaj - مونتاج"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "johnghty1-gif",
        "repo": "montaj"
      }
    ]
  },
  "dependencies": {
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/lalezar": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "@huggingface/transformers": "^3.8.1",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.21",
    "wait-on": "^8.0.5"
  }
}
